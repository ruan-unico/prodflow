{
  "manifest_version": 3,
  "name": "ProdFlow",
  "version": "1.0",
  "description": "Mostra quanto tempo você passou em cada aba do navegador. Analise sua produtividade!",

  "permissions": ["tabs", "storage", "activeTab"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "index.html",
    "default_title": "ProdFlow",
    "default_icon": {
      "16": "icons/prodflow-icon.png",
      "48": "icons/prodflow-icon.png"
    }
  },

  "icons": {
    "16": "icons/prodflow-icon.png",
    "48": "icons/prodflow-icon.png",
    "128": "icons/prodflow-icon.png"
  }
}